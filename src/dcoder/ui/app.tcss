/* DCoder TUI Theme — Variable-based CSS
 *
 * Theme color variables automatically resolved from theme.py
 * Layer ordering: base → autocomplete → overlay
 */

/* ── Screen layers (critical for z-ordering) ─────────── */

Screen {
    layers: base autocomplete overlay;
    background: $background;
    color: $foreground;
}

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

/* ── Universal Scrollbar Styling ────────────────────────── */

* {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

Scrollbar {
    background: $surface;
    color: $primary;
}

Scrollbar:hover {
    background: $surface;
    color: $primary-lighten-1;
}

/* ── Message list scroll area ────────────────────────────── */

#messages {
    height: 1fr;
    background: $background;
    scrollbar-size-vertical: 1;
    padding-bottom: 1;
}

/* ── Bottom container ────────────────────────────────── */

#bottom-container {
    height: auto;
    margin: 0;
    padding: 0;
}

/* ── Diff lines ──────────────────────────────────────── */

.diff-line-added {
    background: $plan-add;
}

.diff-line-removed {
    background: $plan-destroy;
}

.diff-line-hunk {
    color: $primary;
}

.diff-line-header {
    text-style: bold;
}

.diff-line-context {
    color: $foreground;
}

.diff-line-truncated {
    color: $foreground;
    text-style: italic;
}

/* ── Status bar ──────────────────────────────────────── */

StatusBar {
    dock: bottom;
    height: 1;
    color: $foreground;
    padding: 0 1;
}

/* ── Chat input ──────────────────────────────────────── */

ChatInput {
    height: auto;
}

ChatInput #input-box {
    height: auto;
    max-height: 20;
    min-height: 3;
    border: solid $primary;
    background: $background;
    color: $foreground;
    padding: 0;
}

ChatInput .input-row {
    height: auto;
    width: 100%;
    layout: horizontal;
    padding: 0 1;
}

ChatInput .input-prompt {
    width: 2;
    height: 1;
    color: $primary;
    text-style: bold;
}

ChatInput ChatTextArea {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 10;
    border: none;
    background: transparent;
    padding: 0;
}

ChatInput:focus #input-box {
    border: solid $primary;
}


/* ── Messages ────────────────────────────────────────── */

/* Mode-specific borders for UserMessage — currently all use $primary */
/* Reserved for future mode-specific border colors if needed */

AssistantMessage {
    padding: 0 1;
    margin: 1 0 0 0;
    color: $foreground;
    pointer: text;
}

ToolCallMessage {
    padding: 0 1;
    margin: 0 0 0 0;
    color: $foreground;
}

ToolCallMessage:hover {
    background: $surface;
}

ErrorMessage {
    height: auto;
    padding: 1 2;
    margin: 1 0 0 0;
    background: $error-muted;
    color: $foreground;
    border-left: wide $error;
    pointer: text;
}

SystemMessage {
    padding: 0 1;
    margin: 1 0 0 0;
    height: auto;
    color: $primary;
    pointer: text;
}

/* ── Queued User Message ─────────────────────────────── */

QueuedUserMessage {
    padding: 0 1;
    margin: 1 0 0 4;
    background: $surface;
    color: $foreground;
    border-left: solid $panel;
}

/* ── Skill Message ──────────────────────────────────── */

SkillMessage {
    padding: 0 1;
    margin: 0 0 0 2;
    border-left: tall $accent;
    color: $foreground;
}

SkillMessage:hover {
    background: $surface;
}

/* ── Approval overlay ────────────────────────────────── */

/* ApprovalMenu styles are now contained within the component's DEFAULT_CSS */


/* ── Overlay panels (model/thread/mcp selectors) ─────── */

ModelSelector, ThreadSelector, MCPViewer {
    layer: overlay;
    dock: right;
    width: 45;
    height: 100%;
    background: $surface;
    border-left: tall $panel;
    padding: 1;
}

/* ── Sub-agent panel ─────────────────────────────────── */

SubagentPanel {
    padding: 0 1;
    margin: 0 0 0 2;
    border-left: tall $primary;
    color: $foreground;
}

/* ── Autocomplete Popup ──────────────────────────────── */

#autocomplete-popup {
    height: auto;
    max-height: 10;
    width: 100%;
    background: $surface;
    border-top: solid $primary;
    scrollbar-size-vertical: 1;
    scrollbar-gutter: stable;
    display: none;
}

/* ── Muted helper class ──────────────────────────────── */

.muted {
    color: $foreground;
    text-style: italic;
}
